# Copy to .env only if it does not exist, then set your own local password.
# Docker Compose reads .env, not this example file. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

# Used by PostgreSQL and the four application containers through Compose environment.
# Application dependency addresses are internal Compose DNS names, not host localhost.
# The same password must match the existing PostgreSQL volume; editing this file
# does not change the password stored in an already initialized database.

# Local Keycloak (http://localhost:8180). Choose your own values; they are only for this machine.
KC_BOOTSTRAP_ADMIN_USERNAME=replace-with-a-keycloak-admin-name
KC_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-keycloak-admin-password
# Client secret of the order-service Keycloak client; the realm import and order-service read the same value.
ORDER_SERVICE_CLIENT_SECRET=replace-with-a-client-secret
# Password of the demo users consumer.one, consumer.two, standard, gold and admin.
DEMO_USER_PASSWORD=replace-with-a-demo-password

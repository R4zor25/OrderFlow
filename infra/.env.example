# Copy to .env only if it does not exist, then set your own local password.
# Docker Compose reads .env, not this example file. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-local-password

# Used by PostgreSQL and the four application containers through Compose environment.
# Application dependency addresses are internal Compose DNS names, not host localhost.
# The same password must match the existing PostgreSQL volume; editing this file
# does not change the password stored in an already initialized database.

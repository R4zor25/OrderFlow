{
  "realm": "orderflow",
  "enabled": true,
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Catalog administration and access to every order" },
      { "name": "CUSTOMER", "description": "Places and manages own orders" }
    ]
  },
  "defaultDefaultClientScopes": ["basic", "orderflow-claims"],
  "clientScopes": [
    {
      "name": "basic",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper",
          "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "orderflow-claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "false" },
      "protocolMappers": [
        { "name": "roles", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": { "claim.name": "roles", "multivalued": "true", "jsonType.label": "String",
                      "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false",
                      "introspection.token.claim": "true" } },
        { "name": "customer_id", "protocol": "openid-connect", "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": { "user.attribute": "customer_id", "claim.name": "customer_id", "jsonType.label": "String",
                      "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false",
                      "introspection.token.claim": "true" } }
      ]
    },
    {
      "name": "pricing.quote",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" }
    }
  ],
  "clients": [
    {
      "clientId": "orderflow-cli",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": ["basic", "orderflow-claims"]
    },
    {
      "clientId": "order-service",
      "publicClient": false,
      "secret": "${ORDER_SERVICE_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "defaultClientScopes": ["basic", "orderflow-claims", "pricing.quote"]
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "config": {
          "kc.user.profile.config": ["{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"customer_id\",\"displayName\":\"Customer ID\",\"validations\":{\"pattern\":{\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",\"error-message\":\"Invalid customer ID\"}},\"permissions\":{\"view\":[\"admin\"],\"edit\":[\"admin\"]},\"multivalued\":false}],\"groups\":[]}"]
        }
      }
    ]
  },
  "users": [
    { "username": "consumer.one", "enabled": true, "email": "consumer.one@example.test", "emailVerified": true,
      "firstName": "Consumer", "lastName": "One", "realmRoles": ["CUSTOMER"],
      "attributes": { "customer_id": ["11111111-1111-4111-8111-111111111111"] },
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }] },
    { "username": "consumer.two", "enabled": true, "email": "consumer.two@example.test", "emailVerified": true,
      "firstName": "Consumer", "lastName": "Two", "realmRoles": ["CUSTOMER"],
      "attributes": { "customer_id": ["22222222-2222-4222-8222-222222222222"] },
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }] },
    { "username": "standard", "enabled": true, "email": "standard@example.test", "emailVerified": true,
      "firstName": "Business", "lastName": "Standard", "realmRoles": ["CUSTOMER"],
      "attributes": { "customer_id": ["33333333-3333-4333-8333-333333333333"] },
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }] },
    { "username": "gold", "enabled": true, "email": "gold@example.test", "emailVerified": true,
      "firstName": "Business", "lastName": "Gold", "realmRoles": ["CUSTOMER"],
      "attributes": { "customer_id": ["44444444-4444-4444-8444-444444444444"] },
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }] },
    { "username": "admin", "enabled": true, "email": "admin@example.test", "emailVerified": true,
      "firstName": "Catalog", "lastName": "Admin", "realmRoles": ["ADMIN"],
      "credentials": [{ "type": "password", "value": "${DEMO_USER_PASSWORD}", "temporary": false }] }
  ]
}
